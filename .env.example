# Server-side only — NEVER use REACT_APP_ for the secret key
CROSSMINT_API_KEY=

# Collection IDs
# Staging (card checkout testing): 4c9de8e6-d34b-4cdf-a76f-b2b7e5194dad
# Production Polygon "Mafia":       3c13991a-1a90-4716-ba6f-85a1f13e3b43
CROSSMINT_COLLECTION_ID=3c13991a-1a90-4716-ba6f-85a1f13e3b43

# staging | production — must match API key prefix (sk_staging_ / sk_production_)
CROSSMINT_ENVIRONMENT=production

# Must be true for live production mints
CROSSMINT_ALLOW_PRODUCTION_MINT=true

CROSSMINT_CHAIN=polygon
CROSSMINT_NFT_NAME=Ape Mafia Club
CROSSMINT_NFT_DESCRIPTION=Unique hand-drawn Ape Mafia Club member.
CROSSMINT_NFT_IMAGE_URL=https://utfs.io/f/3bbc0d16-be69-4928-aac4-327a52422e4b-c4wqtb.jpg

# Same as CROSSMINT_API_KEY when one key has mint + orders.create scopes
CROSSMINT_CHECKOUT_API_KEY=

# Client key (ck_production_... for live / ck_staging_... for test)
REACT_APP_CROSSMINT_CLIENT_API_KEY=
REACT_APP_CROSSMINT_COLLECTION_ID=3c13991a-1a90-4716-ba6f-85a1f13e3b43
# Live sale price in USD (staging often uses 0.01 for tests)
REACT_APP_CROSSMINT_PRICE=11

API_PORT=4000
# Set to your live frontend origin when deploying
CORS_ORIGIN=http://localhost:3000
